# Copy to BE/.env and fill local values. Do not commit real secrets.

# Required. Use the assigned Neon/PostgreSQL branch (not production).
# Prefer postgresql+psycopg:// — postgresql:// / postgres:// are accepted and normalized.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Comma-separated browser origins allowed by CORS (no wildcard with credentials).
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:8080
FRONTEND_URL=http://localhost:5173

# Firebase Authentication. Project ID is required to verify ID tokens (login).
FIREBASE_PROJECT_ID=your-project-id
# Service account JSON path, only needed for the Admin API (change password,
# revocation check). Leave empty if not used. Never commit the file.
FIREBASE_SERVICE_ACCOUNT_PATH=
# Application session lifetime (hours) and max age of recent_id_token (seconds).
SESSION_TTL_HOURS=8
RECENT_LOGIN_MAX_AGE_SECONDS=300

# Optional email (dev)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Enable detailed tracebacks on 500 errors (development only)
DEBUG=false
